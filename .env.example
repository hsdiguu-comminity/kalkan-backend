# Ana API
PORT=
DATABASE_URL=postgresql://kalkan:kalkan_local_dev@localhost:5432/kalkan
REDIS_URL=redis://localhost:6379
JWT_SECRET=
# TR: HS256 adaptörü seçilirse zorunlu. EN: Required for the optional HS256 verifier.
JWT_ISSUER=
JWT_AUDIENCE=
# TR: Base64 kodlu en az 32 rastgele bayt; uygulama başlangıcında çözülür.
# EN: Base64-encoded random key (32+ bytes); decode during application startup.
SUPPORT_MESSAGE_HMAC_KEY=
# TR: createSupportBootstrap export eden yerel modül; api çalışma dizinine göre.
# EN: Local module exporting createSupportBootstrap, relative to the api working directory.
SUPPORT_ADAPTER_MODULE=
CORS_ORIGIN=
AI_SERVICE_URL=
DATA_SERVICE_URL=
TOOLS_SERVICE_URL=

# Araç servisi (dış API anahtarları)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
HIBP_API_KEY=
PHISHTANK_API_KEY=

# docker-compose portları (varsayılan 5432 / 6379)
POSTGRES_PORT=
REDIS_PORT=
